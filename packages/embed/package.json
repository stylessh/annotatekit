{
  "name": "@annotatekit/embed",
  "version": "0.0.0",
  "description": "One script tag to add the AnnotateKit inspector to any site, saving to localStorage or an AnnotateKit server.",
  "keywords": [
    "annotatekit",
    "feedback",
    "annotations",
    "script-tag",
    "widget"
  ],
  "license": "MIT",
  "homepage": "https://github.com/stylessh/annotatekit/tree/main/packages/embed#readme",
  "bugs": {
    "url": "https://github.com/stylessh/annotatekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stylessh/annotatekit.git",
    "directory": "packages/embed"
  },
  "type": "module",
  "sideEffects": [
    "./dist/annotatekit.js",
    "./dist/auto.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/annotatekit.js",
  "jsdelivr": "./dist/annotatekit.js",
  "exports": {
    ".": {
      "@annotatekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/annotatekit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@annotatekit/client": "workspace:*",
    "@annotatekit/core": "workspace:*",
    "@annotatekit/inspector": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./script": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/annotatekit.js"
      },
      "./package.json": "./package.json"
    }
  }
}
