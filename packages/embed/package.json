{
  "name": "@annotatekit/embed",
  "version": "0.0.0",
  "license": "MIT",
  "description": "One script tag to add the AnnotateKit inspector to any site, saving to localStorage or an AnnotateKit server.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/annotatekit.js",
  "jsdelivr": "./dist/annotatekit.js",
  "exports": {
    ".": {
      "@annotatekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script": "./dist/annotatekit.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@annotatekit/client": "workspace:*",
    "@annotatekit/core": "workspace:*",
    "@annotatekit/inspector": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stylessh/annotatekit.git",
    "directory": "packages/embed"
  }
}
