{
  "name": "@annotatekit/server",
  "version": "0.0.0",
  "description": "HTTP server for AnnotateKit: a REST API, live events and a Node adapter over any storage.",
  "keywords": [
    "annotatekit",
    "feedback",
    "annotations",
    "server",
    "rest"
  ],
  "license": "MIT",
  "homepage": "https://github.com/stylessh/annotatekit/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/stylessh/annotatekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stylessh/annotatekit.git",
    "directory": "packages/server"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "annotatekit-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "@annotatekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@annotatekit/core": "workspace:*",
    "@annotatekit/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@annotatekit/client": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
