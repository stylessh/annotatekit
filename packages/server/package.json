{
  "name": "@annotatekit/server",
  "version": "0.0.0",
  "license": "MIT",
  "description": "HTTP server for AnnotateKit: a REST API, live events and a Node adapter over any storage.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@annotatekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@annotatekit/core": "workspace:*",
    "@annotatekit/sqlite": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stylessh/annotatekit.git",
    "directory": "packages/server"
  },
  "bin": {
    "annotatekit-server": "./dist/cli.js"
  },
  "devDependencies": {
    "@annotatekit/client": "workspace:*"
  }
}
