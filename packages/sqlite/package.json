{
  "name": "@annotatekit/sqlite",
  "version": "0.0.0",
  "license": "MIT",
  "description": "SQLite storage adapter for AnnotateKit, on node:sqlite or better-sqlite3.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@annotatekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@annotatekit/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stylessh/annotatekit.git",
    "directory": "packages/sqlite"
  }
}
