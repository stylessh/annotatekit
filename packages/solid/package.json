{
  "name": "@annotatekit/solid",
  "version": "0.0.0",
  "license": "MIT",
  "description": "SolidJS bindings for the AnnotateKit inspector overlay.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@annotatekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@annotatekit/inspector": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": ">=1.8"
  },
  "devDependencies": {
    "@annotatekit/core": "workspace:*",
    "solid-js": "^1.9.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stylessh/annotatekit.git",
    "directory": "packages/solid"
  }
}
