{
  "name": "@annotatekit/inspector",
  "version": "0.0.0",
  "description": "Framework-agnostic Shadow DOM overlay to pick, pin, box and group elements, capturing breakpoint and CSS system context.",
  "keywords": [
    "annotatekit",
    "feedback",
    "annotations",
    "overlay",
    "inspector",
    "shadow-dom"
  ],
  "license": "MIT",
  "homepage": "https://github.com/stylessh/annotatekit/tree/main/packages/inspector#readme",
  "bugs": {
    "url": "https://github.com/stylessh/annotatekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stylessh/annotatekit.git",
    "directory": "packages/inspector"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@annotatekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@annotatekit/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
